{
  "name": "dtc-starter-monorepo",
  "private": false,
  "packageManager": "pnpm@10.11.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm -r dev",
    "build": "pnpm --filter @dtc/backend run build",
    "start": "pnpm --filter @dtc/backend run start",
    "lint": "turbo lint",
    "test": "turbo test",
    "backend:seed": "pnpm --filter @dtc/backend exec medusa db:seed",
    "backend:dev": "pnpm --filter @dtc/backend run dev",
    "backend:build": "pnpm --filter @dtc/backend run build",
    "backend:start": "pnpm --filter @dtc/backend run start",
    "storefront:dev": "turbo dev --filter=@dtc/storefront",
    "storefront:build": "turbo build --filter=@dtc/storefront",
    "storefront:start": "turbo start --filter=@dtc/storefront"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.0.5",
      "@types/react-dom": "19.0.5"
    },
    "onlyBuiltDependencies": [
      "@medusajs/telemetry",
      "@swc/core",
      "esbuild",
      "msgpackr-extract",
      "protobufjs",
      "sharp",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "@medusajs/eslint-plugin": "2.16.0",
    "eslint": "^9.39.4",
    "jiti": "^2.7.0",
    "prettier": "^3.2.5",
    "turbo": "^2.0.14"
  }
}
